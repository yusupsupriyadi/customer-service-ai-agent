# Salin file ini menjadi .env.local, lalu isi key-nya. .env.local tidak ikut di-commit.

# API key Netra untuk model AI (https://app.netraruntime.com/dashboard)
NETRA_API_KEY=
NETRA_MODEL=deepseek/deepseek-v4.1-flash

# API key Deepgram untuk suara ke teks dan teks ke suara (https://console.deepgram.com)
# Perlu izin Member atau lebih tinggi, karena server membuat token sementara untuk browser.
DEEPGRAM_API_KEY=
